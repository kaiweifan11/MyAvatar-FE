# Copy to .env.local for local development.
# Vite only exposes variables prefixed with VITE_ to the browser.
VITE_BE_URL=http://localhost:3001

# Optional. Fixes for words the browser's speech synthesis mispronounces.
# Semicolon-separated word=respelling pairs, matched as whole words.
# Browser TTS has no phoneme control (no SSML), so respelling phonetically is
# the only lever. Short capitalised names often come out as initialisms —
# "Ada" read as "A. D. A." — which this corrects.
# VITE_SPEECH_FIXES=Ada=Ay-duh;NUS=N U S

# Optional. Voice used for spoken answers, matched as a substring of the
# installed voice name. Defaults to "Microsoft Mark". The browser default is
# usually female and varies by machine.
# VITE_SPEECH_VOICE=Microsoft Mark
