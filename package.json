{
  "name": "myavatar",
  "private": true,
  "version": "2.0.0",
  "description": "AI-powered digital twin. See docs/PRD-v2.md.",
  "scripts": {
    "dev": "pnpm --parallel --filter ./client --filter ./server dev",
