# Copy to .env and fill in. Never commit .env.
# On Render, mark every variable you set as *sensitive*.
#
# Only what you actually need is listed. Everything else has a default in the
# code. Deployment settings are in docs/DEPLOYMENT.md.


# ---- Required ----------------------------------------------

# Set a hard PROJECT-level spend cap on this key in the OpenAI dashboard. The
# org-level "monthly budget" is only a notification; requests keep flowing
# past it.
OPENAI_API_KEY=


# ---- Who the avatar is -------------------------------------
#
# Everything the avatar knows comes from here and from the sources below.
# Nothing personal lives in this repo — that is the point of Phase 2.

# Used throughout the prompt. Without it the avatar calls itself "the site owner".
AVATAR_NAME=

# Free-text introduction in your own words: who you are, how you want to come
# across, and anything you would rather it did not discuss.
#
# MUST be wrapped in double quotes if it spans multiple lines. Unquoted, dotenv
# silently truncates the value at the first line and drops the rest with no
# error — the avatar just mysteriously knows almost nothing.
ABOUT_ME=

# Public link to your resume. Google Drive share links are converted to their
# direct-download form automatically, so paste the share URL as-is. Published
# Google Docs are fetched as plain text. PDFs are parsed.
#
# The link must be PUBLIC: in Drive, Share > General access > "Anyone with the
# link". A restricted file returns Google's sign-in page with HTTP 200 rather
# than an error, so the loader checks for that and refuses it.
RESUME_URL=

# Comma- or newline-separated public URLs, fetched fresh at warm-up and held
# only in memory. A bare GitHub profile URL (https://github.com/<user>) is
# expanded into your profile fields plus your public repositories. Everything
# else is fetched and reduced to text.
SOURCE_URLS=


# ---- Notifications -----------------------------------------
#
# Where contact requests and unanswerable questions are sent. With nothing
# configured they are dropped and logged as an error, while the avatar still
# tells the visitor it passed the message on.
#
# Email rather than push, deliberately: a missed push is gone, a missed email
# is still in your inbox and searchable. That log of what people ask is the
# most valuable thing this project produces.
#
# SMTP works with any provider, so switching is a config change, not a code
# change. Two free options that need no domain of your own:
#
#   Gmail  — no third-party signup, uses the account you already have.
#            Requires 2-Step Verification, then an App Password from
#            myaccount.google.com/apppasswords (the page is effectively
#            unreachable through the UI — use that link directly).
#            SMTP_HOST=smtp.gmail.com   SMTP_PORT=587
#            Limit: 500 messages/day. Use the App Password, NOT your Google
#            account password — the latter is rejected outright. Spaces in the
#            app password are fine; the code strips them.
#
#   Brevo  — 300 emails/day free, verify a sender address instead of a domain.
#            SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

