# Copy to .env and fill in. Never commit .env.
# On Render, mark every variable you set as *sensitive*.
#
# Only what you actually need is listed. Everything else has a default in the
# code. Deployment settings are in docs/DEPLOYMENT.md.


# ---- Required ----------------------------------------------

# Set a hard PROJECT-level spend cap on this key in the OpenAI dashboard. The
# org-level "monthly budget" is only a notification; requests keep flowing
# past it.
OPENAI_API_KEY=


# ---- Who the avatar is -------------------------------------
#
# Everything the avatar knows comes from here and from the sources below.
# Nothing personal lives in this repo — that is the point of Phase 2.

# Used throughout the prompt. Without it the avatar calls itself "the site owner".
AVATAR_NAME=

# Free-text introduction in your own words: who you are, how you want to come
# across, and anything you would rather it did not discuss. This is the one
# place you author directly rather than link to, so keep it to voice and
# framing and let the linked sources carry the detail.
ABOUT_ME=

# Public link to your resume. Google Drive share links are converted to their
# direct-download form automatically, so paste the share URL as-is. Published
# Google Docs are fetched as plain text. PDFs are parsed.
RESUME_URL=

# Comma- or newline-separated public URLs, fetched fresh at warm-up and held
# only in memory. A bare GitHub profile URL (https://github.com/<user>) is
# expanded into your profile fields plus your public repositories. Everything
# else is fetched and reduced to text.
SOURCE_URLS=


# ---- Recommended -------------------------------------------

# Contact capture. record_user_details and record_unknown_question notify via
# Pushover. With these unset the tools still report success and the avatar
# still tells the visitor it has passed the message on — but nothing is sent
# and nothing is stored, so anyone who leaves their email vanishes.
PUSHOVER_TOKEN=
PUSHOVER_USER=


# ---- Optional ----------------------------------------------

# OpenAI's server-side web search. Bills per call on top of tokens, so it is
# off by default — but with a thin public footprint it is the avatar's only
# route to anything recent or unindexed. Set to the string "true" to enable.
# ENABLE_WEB_SEARCH=true

# Answering brain and relevance gate are configured separately on purpose: the
# gate runs on every message and emits one token, so it stays cheap. Any model
# named here must also be on the OpenAI project's allow-list, or calls fail
# with a permission error that reads like a code bug.
# CHAT_MODEL=gpt-4o-mini
# GATE_MODEL=gpt-4o-mini
